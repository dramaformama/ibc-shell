{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ibc server",
  "version": "0.1.0",
  "identifier": "app.ibcserver.desktop",
  "build": {
    "beforeDevCommand": "pnpm -C ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm -C ui build",
    "frontendDist": "../ui/build"
  },
  "app": {
    "windows": [
      { "title": "ibc server", "width": 1100, "height": 720, "minWidth": 480, "minHeight": 360 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
